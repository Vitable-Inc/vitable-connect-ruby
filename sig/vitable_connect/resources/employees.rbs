module VitableConnect
  module Resources
    class Employees
      def retrieve: (
        String employee_id,
        ?request_options: VitableConnect::request_opts
      ) -> VitableConnect::Models::EmployeeRetrieveResponse

      def update: (
        String employee_id,
        effective_date: Date,
        ?address: VitableConnect::EmployeeUpdateParams::Address?,
        ?compensation_type: VitableConnect::Models::EmployeeUpdateParams::compensation_type?,
        ?email: String?,
        ?employee_class: VitableConnect::Models::employee_class?,
        ?gender: VitableConnect::Models::EmployeeUpdateParams::gender?,
        ?phone: String?,
        ?start_date: Date?,
        ?request_options: VitableConnect::request_opts
      ) -> VitableConnect::Models::EmployeeUpdateResponse

      def list_enrollments: (
        String employee_id,
        ?limit: Integer,
        ?page: Integer,
        ?request_options: VitableConnect::request_opts
      ) -> VitableConnect::Internal::PageNumberPage[VitableConnect::Enrollment]

      def initialize: (client: VitableConnect::Client) -> void
    end
  end
end
