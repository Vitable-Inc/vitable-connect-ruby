module VitableConnect
  module Resources
    class Employers
      def create: (
        address: VitableConnect::EmployerCreateParams::Address,
        ein: String,
        email: String,
        legal_name: String,
        name: String,
        ?phone_number: String?,
        ?reference_id: String?,
        ?request_options: VitableConnect::request_opts
      ) -> VitableConnect::EmployerResponse

      def retrieve: (
        String employer_id,
        ?request_options: VitableConnect::request_opts
      ) -> VitableConnect::EmployerResponse

      def list: (
        ?benefit_family: ::Array[VitableConnect::Models::EmployerListParams::benefit_family],
        ?benefit_lifecycle_stage: ::Array[VitableConnect::Models::EmployerListParams::benefit_lifecycle_stage],
        ?hris_status: ::Array[VitableConnect::Models::EmployerListParams::hris_status],
        ?include_cancelled: bool,
        ?limit: Integer,
        ?page: Integer,
        ?search: String?,
        ?request_options: VitableConnect::request_opts
      ) -> VitableConnect::Internal::PageNumberPage[VitableConnect::Models::EmployerListResponse]

      def list_employees: (
        String employer_id,
        ?employment_status: VitableConnect::Models::EmployerListEmployeesParams::employment_status,
        ?limit: Integer,
        ?page: Integer,
        ?search: String,
        ?request_options: VitableConnect::request_opts
      ) -> VitableConnect::Internal::PageNumberPage[VitableConnect::Employee]

      def submit_census_sync: (
        String employer_id,
        employees: ::Array[VitableConnect::EmployerSubmitCensusSyncParams::Employee],
        ?request_options: VitableConnect::request_opts
      ) -> VitableConnect::Models::EmployerSubmitCensusSyncResponse

      def update_settings: (
        String employer_id,
        pay_frequency: VitableConnect::Models::EmployerUpdateSettingsParams::pay_frequency,
        ?request_options: VitableConnect::request_opts
      ) -> VitableConnect::Models::EmployerUpdateSettingsResponse

      def initialize: (client: VitableConnect::Client) -> void
    end
  end
end
