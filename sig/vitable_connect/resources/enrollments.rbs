module VitableConnect
  module Resources
    class Enrollments
      def retrieve: (
        String enrollment_id,
        ?request_options: VitableConnect::request_opts
      ) -> VitableConnect::Models::EnrollmentRetrieveResponse

      def reissue: (
        String enrollment_id,
        ?qualifying_life_event_id: String?,
        ?reason: String?,
        ?ticket_number: String?,
        ?request_options: VitableConnect::request_opts
      ) -> VitableConnect::Models::EnrollmentReissueResponse

      def terminate: (
        String enrollment_id,
        ?qualifying_life_event_id: String?,
        ?reason: String?,
        ?ticket_number: String?,
        ?request_options: VitableConnect::request_opts
      ) -> nil

      def initialize: (client: VitableConnect::Client) -> void
    end
  end
end
