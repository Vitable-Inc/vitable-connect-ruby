module VitableConnect
  module Models
    type auth_list_personas_response_item =
      {
        display_name: String,
        user_type: VitableConnect::Models::AuthListPersonasResponseItem::user_type
      }

    class AuthListPersonasResponseItem < VitableConnect::Internal::Type::BaseModel
      attr_accessor display_name: String

      attr_accessor user_type: VitableConnect::Models::AuthListPersonasResponseItem::user_type

      def initialize: (
        display_name: String,
        user_type: VitableConnect::Models::AuthListPersonasResponseItem::user_type
      ) -> void

      def to_hash: -> {
        display_name: String,
        user_type: VitableConnect::Models::AuthListPersonasResponseItem::user_type
      }

      type user_type =
        :Member
        | :NursePractitioner
        | :CompanyAdmin
        | :VitableAdmin
        | :ClinicalAdmin
        | :PartnerEmployee
        | :OrganizationUser
        | :ExternalAdmin

      module UserType
        extend VitableConnect::Internal::Type::Enum

        MEMBER: :Member
        NURSE_PRACTITIONER: :NursePractitioner
        COMPANY_ADMIN: :CompanyAdmin
        VITABLE_ADMIN: :VitableAdmin
        CLINICAL_ADMIN: :ClinicalAdmin
        PARTNER_EMPLOYEE: :PartnerEmployee
        ORGANIZATION_USER: :OrganizationUser
        EXTERNAL_ADMIN: :ExternalAdmin

        def self?.values: -> ::Array[VitableConnect::Models::AuthListPersonasResponseItem::user_type]
      end
    end

    type auth_list_personas_response =
      ::Array[VitableConnect::Models::AuthListPersonasResponseItem]

    AuthListPersonasResponse: VitableConnect::Internal::Type::Converter
  end
end
