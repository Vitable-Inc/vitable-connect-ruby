module VitableConnect
  module Models
    type member_list_response =
      {
        id: String,
        first_name: String,
        last_name: String,
        address: VitableConnect::Models::MemberListResponse::Address?,
        email: String?,
        phone: String?
      }

    class MemberListResponse < VitableConnect::Internal::Type::BaseModel
      attr_accessor first_name: String

      attr_accessor last_name: String

      attr_accessor address: VitableConnect::Models::MemberListResponse::Address?

      attr_accessor email: String?

      attr_accessor phone: String?

      attr_accessor id: String

      def initialize: (
        id: String,
        first_name: String,
        last_name: String,
        ?address: VitableConnect::Models::MemberListResponse::Address?,
        ?email: String?,
        ?phone: String?
      ) -> void

      def to_hash: -> {
        id: String,
        first_name: String,
        last_name: String,
        address: VitableConnect::Models::MemberListResponse::Address?,
        email: String?,
        phone: String?
      }

      type address =
        {
          :address_line_1 => String,
          city: String,
          state: VitableConnect::Models::MemberListResponse::Address::state,
          zipcode: String,
          :address_line_2 => String?
        }

      class Address < VitableConnect::Internal::Type::BaseModel
        attr_accessor address_line_1: String

        attr_accessor city: String

        attr_accessor state: VitableConnect::Models::MemberListResponse::Address::state

        attr_accessor zipcode: String

        attr_accessor address_line_2: String?

        def initialize: (
          address_line_1: String,
          city: String,
          state: VitableConnect::Models::MemberListResponse::Address::state,
          zipcode: String,
          ?address_line_2: String?
        ) -> void

        def to_hash: -> {
          :address_line_1 => String,
          city: String,
          state: VitableConnect::Models::MemberListResponse::Address::state,
          zipcode: String,
          :address_line_2 => String?
        }

